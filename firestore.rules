rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Members collection
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(memberId);
      allow delete: if isSignedIn();
    }

    // Complaints collection
    match /complaints/{complaintId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(complaintId);
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Maintenance Bills collection
    match /bills/{billId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(billId);
      allow delete: if false;
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(announcementId);
      allow delete: if isSignedIn();
    }
  }
}
