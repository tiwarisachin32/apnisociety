# ApniSociety - Local Development Environment Variables
# Copy this file to .env.local for local overrides if needed.

# Application Port (defaults to 3000)
PORT=3000

# Client Configuration
VITE_APP_NAME="ApniSociety"
VITE_APP_TAGLINE="Society Management Made Simple"

# FastAPI Backend URL (switches app from Firebase to local/cloud FastAPI)
VITE_API_URL="http://localhost:8000"
